# workspace. Infrastructure definitions and templates remain trackable.
/appdata/
/domains/
/isos/
/system/
/mnt/
/.unraid/
/unraid/appdata/
/unraid/domains/
/unraid/isos/
/unraid/system/
/unraid/logs/
/unraid/secrets/

# Sensitive machine-local Unraid boot configuration
/config/super.dat
/config/*.key
/config/passwd
/config/shadow
/config/smbpasswd
/config/network.cfg
/config/ssh/
/config/ssl/
/config/wireguard/

