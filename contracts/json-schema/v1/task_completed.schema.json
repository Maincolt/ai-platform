{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-platform:contract:message:task-completed:1.0",
  "title": "TaskCompleted",
  "description": "Event message on the task-outcomes channel: Test Agent -> Orchestrator. Per ADR-0004 Section 5 (envelope) and vertical-slice-01.md Section 10 (payload).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "message_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "message_kind": {
      "const": "event"
    },
    "contract_name": {
      "const": "TaskCompleted"
    },
    "contract_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Propagated unchanged from the workflow's durable correlation_id."
    },
    "causation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "The causing ExecuteTask command's message_id."
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "task_attempt_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "instance_id"],
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1
        },
        "instance_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "result", "completed_at", "capability", "capability_version"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "description": "The unchanged input text (Section 10)."
        },
        "result": {
          "type": "object",
          "description": "Capability-scoped result payload; exact shape validated per-capability below (ADR-0015).",
          "minProperties": 1
        },
        "completed_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the first accepted completion."
        },
        "capability": {
          "enum": ["text.word-count", "text.summarize", "code.review", "ui.review", "architecture.review", "data.analysis", "technical.review", "security.review", "assignment.route"]
        },
        "capability_version": {
          "const": "1.0"
        },
        "agent": {
          "type": "object",
          "description": "Agent implementation evidence retained by the terminal event (Section 10).",
          "additionalProperties": false,
          "properties": {
            "component": {
              "type": "string",
              "minLength": 1
            },
            "instance_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          }
        }
      }
    }
  },
  "required": [
    "message_id",
    "message_kind",
    "contract_name",
    "contract_version",
    "created_at",
    "correlation_id",
    "causation_id",
    "workflow_id",
    "task_id",
    "task_attempt_id",
    "producer",
    "payload"
  ],
  "allOf": [
    {
      "if": {
        "properties": { "payload": { "properties": { "capability": { "const": "text.word-count" } } } }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "result": {
                "additionalProperties": false,
                "required": ["word_count"],
                "properties": {
                  "word_count": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "payload": { "properties": { "capability": { "const": "text.summarize" } } } }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "result": {
                "additionalProperties": false,
                "required": ["summary"],
                "properties": {
                  "summary": { "type": "string", "minLength": 1, "maxLength": 2000 }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "payload": { "properties": { "capability": { "const": "code.review" } } } }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "result": {
                "additionalProperties": false,
                "required": ["findings"],
                "properties": {
                  "findings": {
                    "type": "array",
                    "description": "Advisory only (ADR-0018 Decision 1): never applied automatically.",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["file", "line", "summary", "severity"],
                      "properties": {
                        "file": { "type": "string", "minLength": 1 },
                        "line": { "type": ["integer", "null"], "minimum": 0 },
                        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
                        "severity": { "enum": ["low", "medium", "high"] }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "payload": { "properties": { "capability": { "const": "ui.review" } } } }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "result": {
                "additionalProperties": false,
                "required": ["findings"],
                "properties": {
                  "findings": {
                    "type": "array",
                    "description": "Advisory only (ADR-0019 Decision 2): never applied automatically.",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["area", "summary", "severity"],
                      "properties": {
                        "area": { "type": "string", "minLength": 1, "maxLength": 200 },
                        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
                        "severity": { "enum": ["low", "medium", "high"] }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "payload": { "properties": { "capability": { "const": "architecture.review" } } } }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "result": {
                "additionalProperties": false,
                "required": ["findings"],
                "properties": {
                  "findings": {
                    "type": "array",
                    "description": "Advisory only (ADR-0020 Decision 2): never applied automatically.",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["section", "summary", "severity"],
                      "properties": {
                        "section": { "type": "string", "minLength": 1, "maxLength": 200 },
                        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
                        "severity": { "enum": ["low", "medium", "high"] }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "payload": { "properties": { "capability": { "const": "data.analysis" } } } }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "result": {
                "additionalProperties": false,
                "required": ["findings"],
                "properties": {
                  "findings": {
                    "type": "array",
                    "description": "Advisory only (ADR-0021 Decision 2): never applied automatically.",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["metric", "summary", "severity"],
                      "properties": {
                        "metric": { "type": "string", "minLength": 1, "maxLength": 200 },
                        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
                        "severity": { "enum": ["low", "medium", "high"] }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "payload": { "properties": { "capability": { "const": "technical.review" } } } }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "result": {
                "additionalProperties": false,
                "required": ["findings"],
                "properties": {
                  "findings": {
                    "type": "array",
                    "description": "Advisory only (ADR-0022 Decision 2): never applied automatically.",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["component", "summary", "severity"],
                      "properties": {
                        "component": { "type": "string", "minLength": 1, "maxLength": 200 },
                        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
                        "severity": { "enum": ["low", "medium", "high"] }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "payload": { "properties": { "capability": { "const": "security.review" } } } }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "result": {
                "additionalProperties": false,
                "required": ["findings"],
                "properties": {
                  "findings": {
                    "type": "array",
                    "description": "Advisory only (ADR-0025 Decision 2): never applied automatically.",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["location", "summary", "severity"],
                      "properties": {
                        "location": { "type": "string", "minLength": 1, "maxLength": 200 },
                        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
                        "severity": { "enum": ["low", "medium", "high"] }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "payload": { "properties": { "capability": { "const": "assignment.route" } } } }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "result": {
                "additionalProperties": false,
                "required": ["assignments"],
                "properties": {
                  "assignments": {
                    "type": "array",
                    "description": "Advisory only (ADR-0023 Decision 2): nothing is dispatched automatically. Names which of the team's other capabilities should look at the input.",
                    "maxItems": 6,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["capability", "rationale"],
                      "properties": {
                        "capability": {
                          "enum": [
                            "text.summarize",
                            "code.review",
                            "ui.review",
                            "architecture.review",
                            "data.analysis",
                            "technical.review",
                            "security.review"
                          ]
                        },
                        "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
